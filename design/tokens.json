{
  "$metadata": {
    "name": "Cova iOS Design Tokens",
    "version": "1.0.0",
    "date": "2026-09-17",
    "source": "多端/web src/app/globals.css（v2.26 语义层）+ cova ip 品牌规范",
    "consumption": "Figma Variables（Tokens Studio 导入，Light/Dark 两个 mode）与 Swift（CovaUI/DesignTokens.swift，G3 转译）",
    "rule": "实现只允许引用 token，禁止散落硬编码色值/字号/间距"
  },
  "color": {
    "accent": {
      "$type": "color",
      "description": "品牌唯一主题色：日落橙。产品 UI 全局 accent",
      "light": "#FF6B00",
      "dark": "#FF6B00"
    },
    "accentHover": { "$type": "color", "light": "#E66000", "dark": "#FF7A1A" },
    "accentSoft": {
      "$type": "color",
      "description": "浅橙衬底（选中背景/tag 底）",
      "light": "#FFF1E6",
      "dark": "#3A1D05"
    },
    "accentText": {
      "$type": "color",
      "description": "accent 语境下的文字色（对比度 ≥4.5:1）",
      "light": "#C24E00",
      "dark": "#FFB173"
    },
    "canvas": { "$type": "color", "light": "#FFFFFF", "dark": "#0C0C14" },
    "surface": { "$type": "color", "light": "#F5F5F7", "dark": "#12121A" },
    "elevated": { "$type": "color", "light": "#FFFFFF", "dark": "#1A1A24" },
    "fg": { "$type": "color", "light": "#1D1D1F", "dark": "#F2F0EC" },
    "secondary": { "$type": "color", "light": "#6E6E73", "dark": "#A1A1AA" },
    "muted": { "$type": "color", "light": "#86868B", "dark": "#6E6E73" },
    "line": { "$type": "color", "light": "#E8E8ED", "dark": "#252530" },
    "lineSubtle": { "$type": "color", "light": "#D2D2D7", "dark": "#1E1E2A" },
    "success": { "$type": "color", "light": "#30D158", "dark": "#30D158" },
    "error": { "$type": "color", "light": "#FF453A", "dark": "#FF453A" },
    "warning": { "$type": "color", "light": "#FF9F0A", "dark": "#FF9F0A" },
    "memberGold": { "$type": "color", "light": "#66511F", "dark": "#D9A52F" },
    "memberGoldSoft": { "$type": "color", "light": "#F7F0D8", "dark": "#2A2210" },
    "memberGoldBorder": { "$type": "color", "light": "#C8AA5A", "dark": "#66511F" },
    "enterpriseBlue": { "$type": "color", "light": "#006EDC", "dark": "#79BEFF" },
    "enterpriseBlueSoft": { "$type": "color", "light": "#EAF4FF", "dark": "#0A2540" },
    "enterpriseBlueBorder": { "$type": "color", "light": "#84BDF3", "dark": "#1D4ED8" },
    "tagScene": { "$type": "color", "light": "#0D9488", "dark": "#2DD4BF" },
    "tagMood": { "$type": "color", "light": "#6366F1", "dark": "#818CF8" }
  },
  "gradient": {
    "ai": {
      "$type": "gradient",
      "description": "AI 语境渐变：仅创作入口与 agent 文字/装饰",
      "value": "linear-gradient(110deg, #FF9A3D, #FF6B00 42%, #E84E8A, #FF9A3D)"
    },
    "brandButton": {
      "$type": "gradient",
      "description": "主按钮深渐变（白字对比度达标）",
      "value": "linear-gradient(110deg, #D04E00, #C24E00 42%, #C03470, #D04E00)"
    }
  },
  "radius": {
    "control": { "$type": "dimension", "value": 12 },
    "card": { "$type": "dimension", "value": 18 },
    "hero": { "$type": "dimension", "value": 28 },
    "capsule": { "$type": "dimension", "value": 9999 }
  },
  "spacing": {
    "xs": { "$type": "dimension", "value": 4 },
    "sm": { "$type": "dimension", "value": 8 },
    "md": { "$type": "dimension", "value": 12 },
    "lg": { "$type": "dimension", "value": 16 },
    "xl": { "$type": "dimension", "value": 24 },
    "xxl": { "$type": "dimension", "value": 32 },
    "pageGutter": { "$type": "dimension", "value": 20 }
  },
  "type": {
    "largeTitle": { "$type": "font", "family": "SF Pro", "size": 34, "weight": 700, "tracking": -0.01 },
    "title": { "$type": "font", "family": "SF Pro", "size": 28, "weight": 700, "tracking": -0.01 },
    "headline": { "$type": "font", "family": "SF Pro", "size": 17, "weight": 600 },
    "body": { "$type": "font", "family": "SF Pro", "size": 17, "weight": 400, "lineHeight": 1.47 },
    "callout": { "$type": "font", "family": "SF Pro", "size": 15, "weight": 400 },
    "subhead": { "$type": "font", "family": "SF Pro", "size": 13, "weight": 400 },
    "caption": { "$type": "font", "family": "SF Pro", "size": 11, "weight": 400 },
    "mono": { "$type": "font", "family": "SF Mono", "size": 13, "weight": 400 },
    "note": "全局 tabular-nums（monospacedDigit）；Dynamic Type 全量适配"
  },
  "motion": {
    "curve": { "$type": "cubicBezier", "value": [0.32, 0.72, 0.24, 1], "swift": "spring(response:dampingFraction:) 对齐" },
    "duration": {
      "instant": 200, "fast": 240, "normal": 300, "slow": 360, "page": 520, "hero": 700,
      "$type": "ms"
    },
    "reduceMotion": "装饰性动效全部需替代态（透明度渐变或直接呈现）"
  },
  "elevation": {
    "primaryButtonShadow": "0 6pt 18pt rgba(230,96,0,0.22)",
    "glassButtonShadowLight": "0 2pt 6pt rgba(20,45,80,0.07), 0 14pt 40pt rgba(20,45,80,0.17)",
    "glassButtonShadowDark": "0 14pt 44pt rgba(0,0,0,0.55)",
    "zOrder": "content < nav(40) < miniPlayer(1000) < overlay(1080) < dialog(1100) < toast(1150)"
  },
  "material": {
    "glass": "系统 Liquid Glass（iOS 26+ glassEffect / regularMaterial）；不自建模糊",
    "navGlass": "对齐 web rgba(245,245,247,0.72)+blur28+saturate180%；深色 rgba(8,8,15,0.55)"
  }
}
